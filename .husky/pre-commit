# Typecheck (strict + noImplicitAny), prop-wiring check, the full test suite
# and the audit gate must pass before every commit. npm.cmd is not directly
# executable by sh on Windows, so the scripts are run through node with cmd.exe
# shell resolution — package.json stays the single source of truth for checks.
#
# The audit gate runs last (lint/tests fail faster and cheaper first) with a
# lockfile-hash cache (node_modules/.cache/audit-gate.json, 24h TTL): commits
# that don't touch dependencies re-audit instantly from the cache. Offline
# (registry unreachable) it only warns — the CI quality job re-checks on push.
# `git commit --no-verify` skips all of this in an emergency.
AUDIT_CACHE=1 AUDIT_SOFT_OFFLINE=1 node -e "require('child_process').execSync('npm run lint && npm test && node scripts/check-audit.mjs',{stdio:'inherit',shell:true})"
