# ============================================
# MAMA THERA Finance Suite — Environment Config
# ============================================
# Copy this file to .env and fill in your values.
# Never commit .env with real secrets to Git!

# === Supabase (Required) ===
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — used by seed scripts, never exposed to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password

# === Gemini AI (for Mama Thera AI Assistant) ===
GEMINI_API_KEY=your-gemini-key

# === App Configuration ===
# Values: development | staging | production
VITE_APP_ENV=development
APP_URL=http://localhost:3000

# === Comptes propriétaires (facultatif, local seulement) ===
# `npm run check:owners` mesure les quatre comptes du roster : présence, état, et
# surtout un login RÉEL par la clé anon. Sans ces variables, le login n'est pas
# mesuré et le contrôle l'annonce (« NON MESURÉ ») — une absence nommée, jamais
# comptée comme un vert. Les valeurs vivent dans Settings → Secrets and variables
# → Actions (noms identiques) ; ne les mettez JAMAIS dans `.env.example`.
OWNER_DEV_PASSWORD=
OWNER_ADMIN_PASSWORD=
OWNER_GM_PASSWORD=
OWNER_STAFF_PASSWORD=
