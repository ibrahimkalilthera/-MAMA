# ============================================
# MAMA THERA Finance Suite — Environment Config
# ============================================
# Copy this file to .env and fill in your values.
# Never commit .env with real secrets to Git!

# === Supabase (Required) ===
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — used by seed scripts, never exposed to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password

# === Account bootstrap (supabase/create_user.mjs) ===
# Used ONLY by the create-user script — never exposed to the browser.
# ADMIN_ROLE: admin | dev | general_manager | staff | econome (default: dev)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
ADMIN_ROLE=dev

# === Gemini AI (for Mama Thera AI Assistant) ===
GEMINI_API_KEY=your-gemini-key

# === App Configuration ===
# Values: development | staging | production
VITE_APP_ENV=development
APP_URL=http://localhost:3000
