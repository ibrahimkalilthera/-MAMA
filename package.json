{
  "name": "mama-thera-finance",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "node scripts/with-pinned-node.mjs --bin vite --port=3000 --host=0.0.0.0",
    "dev:staging": "node scripts/with-pinned-node.mjs --bin vite --port=3000 --host=0.0.0.0 --mode staging",
    "build": "node scripts/with-pinned-node.mjs --bin vite build",
    "build:staging": "node scripts/with-pinned-node.mjs --bin vite build --mode staging",
    "build:production": "node scripts/with-pinned-node.mjs --bin vite build --mode production",
    "preview": "node scripts/with-pinned-node.mjs --bin vite preview",
    "optimize:stamp": "node scripts/optimize-stamp.mjs",
    "check:perf": "node scripts/check-performance.mjs",
    "check:shared-db": "node scripts/check-shared-db.mjs",
    "check:shared-db:live": "node scripts/check-shared-db.mjs --live https://mama-thera-finance.vercel.app",
    "check:automations": "node scripts/check-automations.mjs",
    "check:import-effects": "node scripts/check-import-effects.mjs",
    "check:gate-sentinels": "node scripts/check-gate-sentinels.mjs",
    "check:guard-immunity": "node scripts/check-guard-immunity.mjs",
    "check:node-layout": "node scripts/verify-node-layout.mjs",
    "check:release": "node scripts/check-release-coherence.mjs",
    "check:release:tag": "node scripts/check-release-coherence.mjs --tag",
    "check:release:draft": "node scripts/check-release-coherence.mjs --draft",
    "check:release:live": "node scripts/check-release-coherence.mjs --live",
    "setup:node": "node scripts/setup-node-runtime.mjs",
    "shell": "node scripts/node-shell.mjs",
    "quality": "node scripts/with-pinned-node.mjs --node scripts/quality-chain.mjs",
    "git:retry": "node scripts/git-retry.mjs",
    "orphans:report": "node scripts/sweep-report.mjs",
    "orphans:doctor": "node scripts/panic-doctor.mjs",
    "check:contrast": "node scripts/theme-contrast-audit.mjs",
    "deploy:prod": "node scripts/deploy-notice.mjs",
    "seed": "node --env-file=.env supabase/seed.mjs",
    "seed:staging": "node --env-file=.env.staging supabase/seed.mjs",
    "seed:production": "node --env-file=.env.production supabase/seed-production.mjs",
    "db:snapshot": "node supabase/regenerate-full-setup.mjs",
    "db:snapshot:check": "node supabase/regenerate-full-setup.mjs --check",
    "clean": "rm -rf dist",
    "electron:ui": "node scripts/with-pinned-node.mjs --bin vite build --base=./ --outDir electron-ui-dist",
    "electron:build": "npm run electron:ui && node scripts/check-shared-db.mjs --dist electron-ui-dist && electron-builder --win",
    "electron:dist": "npm run electron:build && npm run check:release",
    "electron:release": "npm run electron:build && npm run check:release && electron-builder --win --publish always && npm run check:release:draft",
    "lint": "node scripts/with-pinned-node.mjs --npm lint:chain",
    "lint:chain": "node scripts/check-node-version.mjs && eslint . --max-warnings 0 --cache --cache-location node_modules/.eslintcache && tsc --noEmit --incremental --tsBuildInfoFile node_modules/tsconfig.tsbuildinfo && node scripts/check-component-props.mjs && node scripts/check-forbidden-any.mjs && node scripts/check-test-harness.mjs && node scripts/check-test-integrity.mjs && stylelint \"src/**/*.css\" --cache --cache-location node_modules/.stylelintcache && node scripts/check-css-selectors.mjs && node scripts/check-no-emoji-icons.mjs && node scripts/check-jsx-i18n.mjs && node scripts/check-date-windows.mjs && node scripts/check-line-budget.mjs && node scripts/check-ci-commands.mjs && node scripts/check-import-effects.mjs && node scripts/check-gate-sentinels.mjs && node scripts/check-guard-immunity.mjs && node scripts/check-shared-db.mjs && node supabase/regenerate-full-setup.mjs --check",
    "test": "node --import tsx --experimental-test-module-mocks --test \"tests/*.test.ts\" \"tests/*.test.tsx\"",
    "prepare": "node scripts/setup-node-runtime.mjs --soft && husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "electron-updater": "^6.8.9",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "description": "Application de gestion financière scolaire (MAMA THERA) — version bureau Windows.",
  "author": "MAMA THERA",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "main": "electron/main.cjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.4.1",
    "pdfjs-dist": "^6.3.289",
    "puppeteer-core": "^25.10.0",
    "stylelint": "^17.15.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "esbuild": true,
    "core-js": true
  }
}
