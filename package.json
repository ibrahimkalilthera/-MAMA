{
  "name": "mama-thera-finance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:staging": "vite --port=3000 --host=0.0.0.0 --mode staging",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "optimize:stamp": "node scripts/optimize-stamp.mjs",
    "check:perf": "node scripts/check-performance.mjs",
    "quality": "node scripts/quality-chain.mjs",
    "check:contrast": "node scripts/theme-contrast-audit.mjs",
    "deploy:prod": "node scripts/deploy-notice.mjs",
    "seed": "node --env-file=.env supabase/seed.mjs",
    "seed:staging": "node --env-file=.env.staging supabase/seed.mjs",
    "seed:production": "node --env-file=.env.production supabase/seed-production.mjs",
    "db:snapshot": "node supabase/regenerate-full-setup.mjs",
    "db:snapshot:check": "node supabase/regenerate-full-setup.mjs --check",
    "db:profiles:export": "node --env-file=.env supabase/restore-profiles.mjs export",
    "db:profiles:restore": "node --env-file=.env supabase/restore-profiles.mjs restore",
    "clean": "rm -rf dist",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit && node scripts/check-component-props.mjs && node scripts/check-forbidden-any.mjs && node scripts/check-test-harness.mjs && stylelint \"src/**/*.css\" && node scripts/check-css-selectors.mjs && node scripts/check-no-emoji-icons.mjs && node scripts/check-jsx-i18n.mjs && node scripts/check-line-budget.mjs && node scripts/check-sheetjs-pin.mjs",
    "test": "node --import tsx --experimental-test-module-mocks --test \"tests/*.test.ts\" \"tests/*.test.tsx\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "happy-dom": "^20.12.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.4.1",
    "puppeteer-core": "^25.10.0",
    "stylelint": "^17.14.1",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.2.0"
  },
  "allowScripts": {
    "esbuild": true,
    "core-js": true
  }
}
