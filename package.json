{
  "name": "mama-thera-finance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:staging": "vite --port=3000 --host=0.0.0.0 --mode staging",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "check:perf": "node scripts/check-performance.mjs",
    "deploy:prod": "npm run check:perf && vercel --prod --yes",
    "seed": "node --env-file=.env supabase/seed.mjs",
    "seed:staging": "node --env-file=.env.staging supabase/seed.mjs",
    "seed:production": "node --env-file=.env.production supabase/seed-production.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint . && tsc --noEmit && node scripts/check-component-props.mjs",
    "test": "node --import tsx --test \"tests/*.test.ts\" \"tests/*.test.tsx\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.4.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.68.0",
    "vercel": "^59.9.1",
    "vite": "^6.2.0"
  },
  "allowScripts": {
    "esbuild": true,
    "core-js": true
  }
}
